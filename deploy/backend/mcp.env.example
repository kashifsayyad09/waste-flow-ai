# /etc/wasteflow/mcp.env  (BACKEND EC2) — never commit the real file.
#   sudo install -m 0640 -o root -g wasteflow mcp.env /etc/wasteflow/mcp.env
APP_ENV=production

# Same token as MCP_API_TOKEN in /etc/wasteflow/backend.env. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_API_TOKEN=<MCP_API_TOKEN_32_PLUS_RANDOM_CHARS>
MCP_HOST=127.0.0.1
MCP_PORT=8001

# Use a SELECT-only database user for this service (it never writes).
DB_HOST=<RDS_ENDPOINT>
DB_PORT=3306
DB_NAME=wasteflow
DB_USER=<RDS_READONLY_USER>
DB_PASSWORD=<RDS_READONLY_PASSWORD>
DB_SSL_CA=/etc/wasteflow/certs/global-bundle.pem
