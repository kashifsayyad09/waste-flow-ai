# secrets (real env files never committed; only *.example is tracked)
.env
.env.*
!.env.example
backend/.env
mcp-server/.env
*.pem
*.key

# python
backend/venv/
venv/
.venv/
mcp-server/.venv/
__pycache__/
*.pyc
.pytest_cache/

# node
node_modules/
dist/
*.tsbuildinfo

# nginx runtime files
nginx/logs/*
!nginx/logs/.gitkeep
nginx/*_temp/
