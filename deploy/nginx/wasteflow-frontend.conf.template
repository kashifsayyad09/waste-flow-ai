# WasteFlow AI — production Nginx for the FRONTEND EC2 (Amazon Linux).
#
# Browser -> this Nginx :80 --static files--> /var/www/wasteflow/current (Vite build)
#                           --/api/, /health--> Backend EC2 private host :8000
#
# BACKEND_PRIVATE_HOST is a placeholder. deploy/frontend/deploy-frontend.sh replaces it
# (with the backend's private IP or private DNS name) and installs the result as
# /etc/nginx/conf.d/wasteflow.conf. Never put a public IP here and never expose :8000.
#
# CORS: the browser only ever talks to this origin, so no CORS headers are added here.

upstream wasteflow_backend {
    server BACKEND_PRIVATE_HOST:8000;
    keepalive 16;
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name wasteflow-frontend;   # default_server below catches every Host; a distinct name avoids clashing with the stock '_' server
    server_tokens off;

    root /var/www/wasteflow/current;
    index index.html;

    client_max_body_size 1m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # --- AI endpoints: photo uploads (<= 3 MB image) and slower LLM calls -----
    location /api/v1/ai/ {
        client_max_body_size 5m;     # app limit is 3 MB; headroom for multipart overhead
        proxy_pass http://wasteflow_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 10s;
        proxy_send_timeout    90s;
        proxy_read_timeout    90s;      # Groq + tool calls can take a while

        error_page 502 503 504 = @api_unavailable;
    }

    # --- API -> backend EC2 (path preserved: /api/v1/bins stays /api/v1/bins) ---
    location /api/ {
        proxy_pass http://wasteflow_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 10s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;

        error_page 502 503 504 = @api_unavailable;
    }

    # --- Health check (FastAPI serves it at /health) ---
    location = /health {
        proxy_pass http://wasteflow_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_read_timeout    10s;

        error_page 502 503 504 = @api_unavailable;
    }

    location @api_unavailable {
        default_type application/json;
        return 502 '{"detail":"Backend is not reachable"}';
    }

    # --- Static frontend ---
    location /assets/ {              # content-hashed filenames: safe to cache for a year
        expires 1y;
        try_files $uri =404;
    }

    location = /index.html {
        expires -1;                  # always revalidate so new releases show immediately
    }

    location / {
        try_files $uri $uri/ /index.html;   # SPA fallback
    }
}
