# /etc/wasteflow/backend.env  (BACKEND EC2) — copy, fill in, then:
#   sudo install -d -m 0750 -o root -g wasteflow /etc/wasteflow
#   sudo install -m 0640 -o root -g wasteflow backend.env /etc/wasteflow/backend.env
# Values containing $ # or spaces must be wrapped in single quotes.
# Never commit the real file.
APP_ENV=production

# Listen on the private interface (or 0.0.0.0); the security group only admits the frontend EC2.
HOST=0.0.0.0
PORT=8000

# Same-origin in production (browser -> frontend Nginx), so CORS is not exercised.
CORS_ORIGINS=http://<FRONTEND_PUBLIC_DNS_OR_DOMAIN>

# Only trust X-Forwarded-* from the frontend EC2's PRIVATE IP.
FORWARDED_ALLOW_IPS=<FRONTEND_PRIVATE_IP>

DB_HOST=<RDS_ENDPOINT>
DB_PORT=3306
DB_NAME=wasteflow
DB_USER=<RDS_APP_USER>
DB_PASSWORD=<RDS_APP_PASSWORD>
# REQUIRED when APP_ENV=production: verifies the RDS certificate and hostname.
DB_SSL_CA=/etc/wasteflow/certs/global-bundle.pem

# --- Phase 3: AI ---------------------------------------------------------------
# The Groq key lives ONLY here, on the backend EC2. It is never sent to the browser.
GROQ_API_KEY=<GROQ_API_KEY>
# Model IDs must exist on YOUR Groq account; the text model must support tool calling,
# the vision model must accept images. Check: console.groq.com or GET https://api.groq.com/openai/v1/models
GROQ_TEXT_MODEL=<GROQ_TEXT_MODEL>
GROQ_VISION_MODEL=<GROQ_VISION_MODEL>

# MCP runs on this same instance, so loopback is correct here (not another EC2).
MCP_SERVER_URL=http://127.0.0.1:8001/mcp
MCP_API_TOKEN=<MCP_API_TOKEN_32_PLUS_RANDOM_CHARS>
