# mcp-server/.env — copy to .env (git-ignored). Never commit the real file.

# Bearer token the backend must present. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_API_TOKEN=<MCP_API_TOKEN_32_PLUS_RANDOM_CHARS>

# Default: listen on loopback only. The backend runs on the same EC2, so 127.0.0.1 is correct.
MCP_HOST=127.0.0.1
MCP_PORT=8001
# MCP_PATH=/mcp
# Extra accepted Host header values if (and only if) the backend reaches MCP over a private DNS name:
# MCP_ALLOWED_HOSTS=<MCP_PRIVATE_DNS_NAME>

# Database (read by the shared backend settings). Use a SELECT-only database user for this service.
DB_HOST=<RDS_ENDPOINT>
DB_PORT=3306
DB_NAME=wasteflow
DB_USER=<RDS_READONLY_USER>
DB_PASSWORD=<RDS_READONLY_PASSWORD>
# DB_SSL_CA=/etc/wasteflow/certs/global-bundle.pem   (required when APP_ENV=production)
# APP_ENV=production
