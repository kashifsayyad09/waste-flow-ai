APP_ENV=development

# FastAPI listens on localhost only; Nginx (port 80) is the public entry point.
HOST=127.0.0.1
PORT=8000

CORS_ORIGINS=http://localhost,http://localhost:5173

# AWS RDS for MySQL — never commit real values (backend/.env is git-ignored)
DB_HOST=<RDS_ENDPOINT>
DB_PORT=3306
DB_NAME=wasteflow
DB_USER=<RDS_USERNAME>
DB_PASSWORD=<RDS_PASSWORD>

# Path to the AWS RDS CA bundle (encrypts AND verifies the connection).
# Optional in development, REQUIRED when APP_ENV=production.
# DB_SSL_CA=/etc/wasteflow/certs/global-bundle.pem

# Optional connection pool tuning (defaults shown)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT=10

# ---------------------------------------------------------------------------
# Phase 3: AI (all optional; features report "not configured" until set)
# Never commit real values. The key stays on the server and is never sent to the browser.
# ---------------------------------------------------------------------------
GROQ_API_KEY=<GROQ_API_KEY>
# Pick model IDs that your Groq account can use (console.groq.com -> Models / GET /openai/v1/models).
# The text model must support tool calling; the vision model must accept image input.
GROQ_TEXT_MODEL=<GROQ_TEXT_MODEL>
GROQ_VISION_MODEL=<GROQ_VISION_MODEL>
# GROQ_TIMEOUT_SECONDS=30
# GROQ_MAX_RETRIES=1

# MCP server (runs on the same host as this backend by default)
MCP_SERVER_URL=http://127.0.0.1:8001/mcp
MCP_API_TOKEN=<MCP_API_TOKEN_32_PLUS_RANDOM_CHARS>
# AI_RATE_LIMIT_PER_MINUTE=20
